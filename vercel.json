{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"EarnPulse.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|webm|ogg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.apk",
      "destination": "https://github.com/globalquraniconlineacademy4-ctrl/earnpulse/releases/download/v1.0.1/EarnPulse.apk",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/bonus",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/cash",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/income",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/free",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    },
    {
      "source": "/bounty",
      "destination": "/register?invite=4E2YOO",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://earnpulse-mpdd.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/((?!api|admin).*)",
      "destination": "/index.html"
    }
  ]
}